# PostgreSQL da integração Neon/Vercel ou banco local
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# A integração Neon/Vercel pode fornecer este nome em vez de DATABASE_URL.
POSTGRES_URL=

# Opcional: habilita o provedor real de IA apenas no backend
AI_PROVIDER=mock
AI_API_KEY=
